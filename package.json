{
	"name": "kevinap29.github.io",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"dev": "npm run paraglide:compile && vite dev --host",
		"dev:open": "vite dev --host --open",
		"build": "npm run paraglide:compile && npm run generate:sitemap && vite build",
		"preview": "vite preview --host",
		"preview:open": "vite preview --host --open",
		"build:preview": "npm run build && npm run preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"format:lint": "npm run format && npm run lint",
		"test:integration": "playwright test",
		"test:unit": "vitest run",
		"generate:sitemap": "node scripts/generate-sitemap.js",
		"generate:pdf": "node scripts/generate-pdfs-from-sitemap.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.9.0",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-static": "^3.0.1",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^24.0.0",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"dotenv": "^16.4.5",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"fast-xml-parser": "^5.7.1",
		"globals": "^15.14.0",
		"pdf-lib": "^1.17.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"puppeteer": "^25.18.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.4.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.0.0",
		"vite": "^8.0.0",
		"vitest": "^5.1.1"
	},
	"type": "module",
	"dependencies": {
		"@inlang/paraglide-js": "^2.16.0",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.9.0",
		"isomorphic-dompurify": "^3.22.0",
		"marked": "^18.0.2",
		"mode-watcher": "^1.1.0",
		"zod": "^4.6.7"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
